{
  "name": "@gw/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "tsc -b tsconfig.build.json && eslint .",
    "typecheck": "tsc -b tsconfig.build.json && tsc --noEmit",
    "test": "tsc -b tsconfig.build.json && vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsc -b tsconfig.build.json && node --env-file-if-exists=../../.env dist/migrate-cli.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  }
}
