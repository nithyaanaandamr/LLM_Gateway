# Copy to .env for local dev. Never commit .env.

NODE_ENV=development

# Ports
GATEWAY_PORT=8080
ADMIN_API_PORT=8081
# Origin the dashboard runs on (scheme, host, port; no path). https unless localhost.
# Also a trusted origin for the admin API (cookie requests).
DASHBOARD_ORIGIN=http://localhost:5173

# Admin API (ADMIN_API_PORT is above)
# 127.0.0.1 = this machine only. Containers set 0.0.0.0.
ADMIN_API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Signs session cookies. At least 32 characters. Dev only: openssl rand -base64 32
# Changing it logs everyone out.
BETTER_AUTH_SECRET=
# Public origin of the admin API (scheme, host, port; no path). https unless localhost.
BETTER_AUTH_URL=http://localhost:8081

# Data stores (see infra/compose.yaml)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379

# Master key for AES-GCM encryption of provider keys.
# Dev only: 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it makes stored provider keys unreadable. In production this comes from a secret store / KMS.
MASTER_KEY=

# Upstream provider. In dev and tests, point at tools/fake-provider.
PROVIDER_BASE_URL=http://localhost:9090

# What to do when Redis is down: closed | open (see PITFALLS.md: Redis failure mode)
REDIS_FAILURE_MODE=closed

# Prompt logging is opt-in (privacy default: metadata only)
LOG_PROMPTS=false
